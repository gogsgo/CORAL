# ── CORAL ──────────────────────────────────────────────────────────────
# Copy to .env and fill what you need. Everything is optional:
# with zero keys CORAL still runs, in paper mode, with a deterministic
# reasoning fallback (see packages/core/src/agent/engine.ts).

# Where the reef lives. Default: ./.coral
CORAL_HOME=

# paper | live   — live refuses to trade unless limits are explicitly raised
CORAL_MODE=paper

# Reasoning provider: anthropic | openai | google | xai | none
CORAL_LLM=anthropic
CORAL_MODEL=claude-sonnet-4-5
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
XAI_API_KEY=

# Robinhood Trading MCP (OAuth-hosted). Token is only needed for live reads/orders.
ROBINHOOD_MCP_URL=https://agent.robinhood.com/mcp/trading
ROBINHOOD_MCP_TOKEN=

# Robinhood Chain (EVM L2, chainId 4663). Public endpoint, no key required.
ROBINHOOD_CHAIN_RPC=https://rpc.mainnet.chain.robinhood.com
